{
	"$schema": "https://v2-9-14.turborepo.dev/schema.json",
	"globalDependencies": ["configs/tsconfig*.json"],
	"tasks": {
		"lint": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/eslint-*.mts",
				"$TURBO_ROOT$/eslint.config.mts",
				"$TURBO_ROOT$/tsconfig.json"
			],
			"env": ["!VITE_SHOWCASE_OSM_TILE_URL"]
		},
		"clean": {},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**",
				"public/img/mapsight**",
				"src/generated/**"
			],
			"env": ["!VITE_SHOWCASE_OSM_TILE_URL"]
		},
		"mapsight-host-starter#build": {
			"dependsOn": [
				"@mapsight/lib-js#build",
				"@mapsight/lib-ol#build",
				"@mapsight/traffic-style#build",
				"@mapsight/ui#build",
				"@mapsight/vector-style-compiler#build",
				"@mapsight/vite-host-embed#build"
			],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**",
				"public/img/mapsight**",
				"src/generated/**"
			]
		},
		"mapsight-next-starter#build": {
			"dependsOn": [
				"@mapsight/lib-js#build",
				"@mapsight/lib-ol#build",
				"@mapsight/traffic-style#build",
				"@mapsight/ui#build",
				"@mapsight/vector-style-compiler#build"
			],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**",
				"public/img/mapsight**",
				"src/generated/**"
			]
		},
		"mapsight-vite-spa-starter#build": {
			"dependsOn": [
				"@mapsight/lib-js#build",
				"@mapsight/lib-ol#build",
				"@mapsight/traffic-style#build",
				"@mapsight/ui#build",
				"@mapsight/vector-style-compiler#build"
			],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**",
				"public/img/mapsight**",
				"src/generated/**"
			]
		},
		"watch": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"env": ["!VITE_SHOWCASE_OSM_TILE_URL"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": [],
			"env": ["!VITE_SHOWCASE_OSM_TILE_URL"]
		},
		"mapsight-host-starter#typecheck": {
			"dependsOn": [
				"@mapsight/lib-js#build",
				"@mapsight/lib-ol#build",
				"@mapsight/traffic-style#build",
				"@mapsight/ui#build",
				"@mapsight/vector-style-compiler#build",
				"@mapsight/vite-host-embed#build"
			],
			"outputs": []
		},
		"mapsight-next-starter#typecheck": {
			"dependsOn": [
				"@mapsight/lib-js#build",
				"@mapsight/lib-ol#build",
				"@mapsight/traffic-style#build",
				"@mapsight/ui#build",
				"@mapsight/vector-style-compiler#build"
			],
			"outputs": []
		},
		"mapsight-vite-spa-starter#typecheck": {
			"dependsOn": [
				"@mapsight/lib-js#build",
				"@mapsight/lib-ol#build",
				"@mapsight/traffic-style#build",
				"@mapsight/ui#build",
				"@mapsight/vector-style-compiler#build"
			],
			"outputs": []
		},
		"//#typecheck:scripts": {
			"outputs": []
		},
		"//#test:configs": {
			"outputs": []
		},
		"//#lint:starters": {
			"outputs": []
		}
	}
}
