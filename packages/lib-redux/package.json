{
	"name": "@mapsight/lib-redux",
	"description": "Mapsight Redux Library",
	"version": "2.2.3",
	"type": "module",
	"dependencies": {
		"@mapsight/lib-js": "workspace:^",
		"@reduxjs/toolkit": "catalog:",
		"lodash": "catalog:"
	},
	"devDependencies": {
		"@types/lodash": "catalog:",
		"cpx2": "^9.0.3",
		"vitest": "catalog:"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		},
		"./reducers/immutable": {
			"types": "./dist/reducers/immutable/index.d.ts",
			"import": "./dist/reducers/immutable/index.js"
		},
		"./reducers/immutable-path": {
			"types": "./dist/reducers/immutable-path/index.d.ts",
			"import": "./dist/reducers/immutable-path/index.js"
		}
	},
	"files": [
		"dist"
	],
	"homepage": "https://github.com/open-mapsight/mapsight/tree/main/packages/lib-redux#readme",
	"license": "MIT",
	"main": "index.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/open-mapsight/mapsight",
		"directory": "packages/lib-redux"
	},
	"scripts": {
		"build": "npm-run-all build:setup build:modules build:copy",
		"build:copy": "cpx '{package.json,README.md}' dist/",
		"build:modules": "tsc -p tsconfig.build.json",
		"build:setup": "mkdirp dist",
		"clean": "rimraf dist/*",
		"clean-build": "run-s clean build",
		"lint": "eslint",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"watch": "run-s build:setup build:modules watch:build",
		"watch:build": "tsc -p tsconfig.build.json --watch"
	}
}
